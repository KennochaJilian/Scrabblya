PORT=3001
HOST=0.0.0.0
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Optional browser origins, comma-separated. Native Android requests have no Origin.
CORS_ORIGINS=http://localhost:8081
# Set only behind a trusted reverse proxy, e.g. 1.
TRUST_PROXY_HOPS=0
# Used only by npm run seed:admin. No default password.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
