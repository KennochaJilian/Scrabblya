{
  "name": "scrabblya-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "seed:admin": "node --env-file-if-exists=.env scripts/seed-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/app.mjs && node --check src/supabase-service.mjs && node --check scripts/seed-admin.mjs",
    "build": "node scripts/build-game.mjs",
    "prestart": "npm run build",
    "predev": "npm run build",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
